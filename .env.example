# ==============================================================================
# OralVision AI — Environment Configuration Template
# Copy this file to .env and configure the variables below:
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# ==============================================================================

# Flask Session & CSRF Security (Required in production)
# Generate a strong key, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string

# Environment Mode: 'development' or 'production'
FLASK_ENV=development
FLASK_DEBUG=false

# Server Port (Default: 5000 for local development, 10000 on Render / Docker)
PORT=5000

# Database Connection (Default: SQLite database inside instance/ directory)
# For production PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=

# Browser Auto-Launch on startup (true / false)
AUTO_OPEN_BROWSER=true

# ==============================================================================
# ULTRON AI Assistant Configuration (Optional)
# If OPENAI_API_KEY is left blank, ULTRON operates using the built-in clinical
# knowledge base with zero external network dependencies and 0 cost.
# Add your key below to unlock generative conversational diagnostic assistance:
# ==============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
